# Google Sign-In (optional)
# Paste the REAL OAuth 2.0 Client ID for a client whose Application type is "Web application".
# Do NOT use a placeholder value and never commit the real .env file to GitHub.
GOOGLE_CLIENT_ID=PASTE_REAL_WEB_CLIENT_ID.apps.googleusercontent.com

# Optional submission storage settings
LOOPKEEPER_UPLOAD_DIR=uploads
LOOPKEEPER_MAX_UPLOAD_BYTES=26214400
